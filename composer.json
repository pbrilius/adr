{
    "name": "oryx/adr",
    "description": "Action Domain Responder (ADR) library for PHP, compatible with oryx/mvc and PWA middleware",
    "type": "library",
    "require": {
        "php": "^8.1",
        "psr/http-message": "^1.0|^2.0",
        "psr/http-server-middleware": "^1.0",
        "laminas/laminas-diactoros": "^2.0|^3.0",
        "oryx/mvc": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0|^10.0",
        "squizlabs/php_codesniffer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Oryx\\Adr\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Oryx\\Adr\\Tests\\": "tests/"
        }
    },
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Povilas Brilius",
            "email": "pbrilius@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit tests",
        "test-coverage": "phpunit tests --coverage-text",
        "cs-check": "phpcs -p --standard=PSR12 src tests",
        "cs-fix": "phpcbf -p --standard=PSR12 src tests"
    }
}
